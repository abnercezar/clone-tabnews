{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Projeto do curso https://www.tabnews.com.br para o https://curso.dev",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && env -u POSTGRES_PORT -u EMAIL_SMTP_PORT -u EMAIL_HTTP_PORT next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run services:up && env -u POSTGRES_PORT -u EMAIL_SMTP_PORT -u EMAIL_HTTP_PORT concurrently -n next,jest --hide next -k -s command-jest \"FIREWALL_ENABLED=false next dev\" \"npm run services:wait:webserver && jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:isolated": "sh infra/scripts/test-isolated.sh",
    "test:watch": "env -u POSTGRES_PORT -u EMAIL_SMTP_PORT -u EMAIL_HTTP_PORT jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "services:wait:webserver": "node infra/scripts/wait-for-webserver.js",
    "curso:lessons": "node infra/scripts/fetch-curso-lessons.mjs",
    "seed:dev": "node infra/scripts/seed-dev.js",
    "admin:promote": "node infra/scripts/promote-admin.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m infra/migrations --envPath .env.development --dry-run up",
    "migrations:up:production": "node-pg-migrate -m infra/migrations --envPath .env.production up",
    "migrations:up:production:dry": "node-pg-migrate -m infra/migrations --envPath .env.production --dry-run up",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "next lint --dir .",
    "security:audit": "node infra/scripts/security-audit.mjs",
    "security:checklist": "node infra/scripts/security-checklist.mjs",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@bytemd/plugin-breaks": "^1.22.0",
    "@bytemd/plugin-gemoji": "^1.22.0",
    "@bytemd/plugin-gfm": "^1.22.0",
    "@bytemd/plugin-highlight-ssr": "^1.22.0",
    "@bytemd/plugin-math": "^1.22.0",
    "@bytemd/plugin-mermaid": "^1.22.0",
    "@bytemd/react": "^1.22.0",
    "@primer/primitives": "11.9.0",
    "@primer/react": "38.32.0",
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "bytemd": "^1.22.0",
    "cookie": "1.1.1",
    "katex": "^0.16.22",
    "mermaid": "^10.9.8",
    "micromatch": "^4.0.8",
    "next": "14.2.35",
    "next-connect": "1.0.0",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "7.0.13",
    "pg": "8.20.0",
    "react": "18.3.1",
    "react-confetti": "^6.1.0",
    "react-dom": "18.3.1",
    "react-rewards": "^2.1.0",
    "recharts": "^2.15.4",
    "swr": "2.4.1",
    "three": "^0.186.1",
    "uuid": "11.1.1",
    "vis-network": "^9.1.9"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@faker-js/faker": "9.9.0",
    "commitizen": "4.3.1",
    "concurrently": "8.2.2",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "16.6.1",
    "dotenv-expand": "11.0.7",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-jest": "28.14.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "prettier": "3.8.3",
    "set-cookie-parser": "2.7.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  }
}
