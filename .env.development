POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=local_user2
POSTGRES_DB=local_db
POSTGRES_PASSWORD=local_password
DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB

EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_HTTP_HOST=localhost
EMAIL_HTTP_PORT=1080
# Google Programmable Search (CSE) — como no TabNews
# Crie em https://programmablesearchengine.google.com/ com site:agrotab.com.br
NEXT_PUBLIC_SEARCH_URL=https://cse.google.com/cse.js?cx=
NEXT_PUBLIC_SEARCH_ID=

# Fotos nas publicações (Cloudflare R2 ou outro bucket compatível com S3).
# Sem estas variáveis o botão "Foto" avisa que o envio ainda não está disponível.
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_BUCKET=agrotab-fotos
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_URL=https://fotos.agrotab.com.br

# Login com Google (OAuth). Redirect autorizado no Google Cloud:
# <origem>/api/v1/sessions/google/callback
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
